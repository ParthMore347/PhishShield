# Copy this file to .env for local development.
# Never commit real credentials.

# MongoDB Atlas connection string for the backend.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Database name used by the backend when Atlas persistence is connected.
MONGODB_DATABASE=phishshield

# Public backend URL used by clients after deployment.
PHISHSHIELD_API_URL=http://localhost:8000
