{
  "manifest_version": 3,
  "name": "PhishShield PC Edge",
  "version": "1.0.0",
  "description": "Real-time active tab link scanning, threat prevention, and full-screen warning block interception.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishShield Active Scan"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "block.html",
        "block.css",
        "block.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
